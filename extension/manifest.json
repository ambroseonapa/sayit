{
  "manifest_version": 3,
  "name": "SayIt – speak into any text box",
  "short_name": "SayIt",
  "version": "0.8.4",
  "description": "Tap the mic, speak, and your words land in the box you're typing in, with grammar and punctuation fixed. It never rewrites you unless you ask.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SayIt: click a text box, then tap here to speak (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.languagetool.org/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.github.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Start / stop speaking"
    }
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "homepage_url": "https://github.com/ambroseonapa/sayit"
}